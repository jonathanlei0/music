uint16_t crcByte(uint16_t value, uint8_t c) {
  return (value << 8) ^ pgm_read_word(CRC_TABLE + ((value >> 8) ^ c));
}
void resetParser() { state=matched=0; index=0; crc=0xffff; }
void publish() {
  // Last-resort current cap on the composed frame; no effects run here.
  uint8_t *pixels=strip.getPixels();
  uint32_t sum=0;
  for (uint16_t i=0;i<FRAME_BYTES;++i) sum+=pixels[i];
  uint32_t idle=(uint32_t)NUM_LEDS*4;
  uint32_t allowed=MAX_MILLIAMPS>idle ? (MAX_MILLIAMPS-idle)*255UL/(4UL*20UL) : 0;
  if (sum>allowed) {
    for (uint16_t i=0;i<FRAME_BYTES;++i) pixels[i]=(uint32_t)pixels[i]*allowed/sum;
  }
  strip.show();
  lit=sum!=0;
  lastFrame=millis();
}
void receiveByte(uint8_t c) {
  lastByte=millis();
  if (!state) {
    const char magic[]="RGB1";
    if (c==magic[matched]) ++matched;
    else matched=c=='R' ? 1 : 0;
    if (matched==4) { state=1; index=0; crc=0xffff; }
  } else if (state==1) {
    header[index++]=c; crc=crcByte(crc,c);
    if (index==4) {
      sequence=(uint16_t)header[0]|((uint16_t)header[1]<<8);
      uint16_t length=(uint16_t)header[2]|((uint16_t)header[3]<<8);
      if (length!=FRAME_BYTES) { resetParser(); return; }
      state=2; index=0; pixelOffset=0; channel=0;
    }
  } else if (state==2) {
    // Wire RGB -> NeoPixel's GRB buffer, with no second 900-byte allocation.
    strip.getPixels()[pixelOffset+(channel==0 ? 1 : channel==1 ? 0 : 2)]=c;
    if (++channel==3) { channel=0; pixelOffset+=3; }
    crc=crcByte(crc,c);
    if (++index==FRAME_BYTES) state=3;
  } else if (state==3) { receivedCrc=c; state=4; }
  else {
    receivedCrc|=(uint16_t)c<<8;
    if (receivedCrc==crc) { publish(); Serial.print("ACK,"); }
    else Serial.print("NAK,");
    Serial.println(sequence); // Host waits until show() has finished before sending.
    resetParser();
  }
}
void setup() {
  Serial.begin(500000);
  strip.begin(); strip.selectGroup(PINS,sizeof(PINS));
  strip.clear(); strip.show();
  Serial.println("READY_RGB1");
}
void loop() {
  if ((state || matched) && millis()-lastByte>100) resetParser();
  while (Serial.available()) receiveByte(Serial.read());
  if (lit && millis()-lastFrame>700) {
    strip.clear(); strip.show(); lit=false;
  }
}
