#include <Adafruit_NeoPixel.h>
#include "mirrored_neopixel.h"
#if !defined(__AVR_ATmega328P__)
#error "Select Arduino Uno (ATmega328P)."
#endif
constexpr uint8_t PINS[] = {5, 6, 7, 4};
constexpr uint16_t NUM_LEDS = 300, FRAME_BYTES = NUM_LEDS * 3;
// Match this to the actual combined supply/wiring budget before expanding effects.
constexpr uint32_t MAX_MILLIAMPS = 60000UL;
MirroredNeoPixel strip(NUM_LEDS, PINS[0], NEO_GRB + NEO_KHZ800);
uint8_t state = 0, matched = 0, header[4];
uint16_t pixelOffset = 0;
uint8_t channel = 0;
uint16_t index = 0, crc = 0xffff, receivedCrc = 0, sequence = 0;
unsigned long lastByte = 0, lastFrame = 0;
bool lit = false;

